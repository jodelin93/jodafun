// This is your Prisma schema file
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid()) 
  username      String?  @unique @db.VarChar(50)
  email         String?  @unique @db.VarChar(255)
  passwordHash  String?  @map("password_hash") @db.VarChar(255)
  isGuest       Boolean  @default(false) @map("is_guest")
  displayName   String?  @map("display_name") @db.VarChar(100)
  name          String?  @db.VarChar(100)
  image         String?  @db.VarChar(500)
  avatarUrl     String?  @map("avatar_url") @db.VarChar(500)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  lastLoginAt   DateTime? @map("last_login_at")
  emailVerified Boolean  @default(false) @map("email_verified")

  // Relations
  gamesAsPlayer1    Game[]         @relation("Player1Games")
  gamesAsPlayer2    Game[]         @relation("Player2Games")
  gamesWon          Game[]         @relation("WinnerGames")
  roundsWon         GameRound[]    @relation("RoundWinner")
  friendships       Friendship[]   @relation("UserFriendships")
  friendOf          Friendship[]   @relation("FriendOfUser")
  matchHistoryAsUser    MatchHistory[] @relation("UserMatches")
  matchHistoryAsOpponent MatchHistory[] @relation("OpponentMatches")
  sessions          Session[]
  accounts          Account[]
  verifications     Verification[]
  soloRuns          SoloRun[]
  gameParticipations GameParticipant[]

  @@index([username])
  @@index([email])
  @@map("users")
}

// Better Auth Session table
model Session {
  id        String   @id @default(uuid()) 
  userId    String   @map("user_id") 
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  userAgent String?  @map("user_agent") @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("sessions")
}

// Better Auth Account table (for OAuth providers)
model Account {
  id                String   @id @default(uuid()) 
  userId            String   @map("user_id") 
  accountId         String   @map("account_id") @db.VarChar(255)
  providerId        String   @map("provider_id") @db.VarChar(255)
  accessToken       String?  @map("access_token") @db.Text
  refreshToken      String?  @map("refresh_token") @db.Text
  idToken           String?  @map("id_token") @db.Text
  accessTokenExpiresAt DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope             String?  @db.Text
  password          String?  @db.Text
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Game {
  id          String    @id @default(uuid()) 
  gameType    String    @map("game_type") @db.VarChar(50)
  roomCode    String?   @unique @map("room_code") @db.VarChar(6)
  status      String    @default("waiting") @db.VarChar(20)
  player1Id   String?   @map("player1_id") 
  player2Id   String?   @map("player2_id") 
  winnerId    String?   @map("winner_id") 
  settings    Json?     @db.JsonB
  createdAt   DateTime  @default(now()) @map("created_at")
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")

  // Relations
  player1      User?         @relation("Player1Games", fields: [player1Id], references: [id])
  player2      User?         @relation("Player2Games", fields: [player2Id], references: [id])
  winner       User?         @relation("WinnerGames", fields: [winnerId], references: [id])
  rounds       GameRound[]
  matchHistory MatchHistory[]
  participants GameParticipant[]
  moves        GameMove[]
  hands        GameHand[]

  @@index([roomCode])
  @@index([status])
  @@map("games")
}

model GameRound {
  id            String    @id @default(uuid()) 
  gameId        String    @map("game_id") 
  roundNumber   Int       @map("round_number")
  player1Score  Int       @default(0) @map("player1_score")
  player2Score  Int       @default(0) @map("player2_score")
  winnerId      String?   @map("winner_id") 
  startedAt     DateTime  @default(now()) @map("started_at")
  completedAt   DateTime? @map("completed_at")

  // Relations
  game   Game  @relation(fields: [gameId], references: [id], onDelete: Cascade)
  winner User? @relation("RoundWinner", fields: [winnerId], references: [id])

  @@unique([gameId, roundNumber])
  @@map("game_rounds")
}

model Friendship {
  id        String   @id @default(uuid()) 
  userId    String   @map("user_id") 
  friendId  String   @map("friend_id") 
  status    String   @default("pending") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user   User @relation("UserFriendships", fields: [userId], references: [id], onDelete: Cascade)
  friend User @relation("FriendOfUser", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
  @@map("friendships")
}

model MatchHistory {
  id         String   @id @default(uuid()) 
  gameId     String   @map("game_id") 
  userId     String   @map("user_id") 
  opponentId String?  @map("opponent_id") 
  result     String   @db.VarChar(10)
  roundsWon  Int      @default(0) @map("rounds_won")
  roundsLost Int      @default(0) @map("rounds_lost")
  totalScore Int      @default(0) @map("total_score")
  playedAt   DateTime @default(now()) @map("played_at")

  // Relations
  game     Game  @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user     User  @relation("UserMatches", fields: [userId], references: [id], onDelete: Cascade)
  opponent User? @relation("OpponentMatches", fields: [opponentId], references: [id])

  @@index([userId])
  @@index([playedAt])
  @@map("match_history")
}

// Better Auth Verification table
model Verification {
  id         String   @id @default(uuid()) 
  identifier String   @db.VarChar(255)
  value      String   @db.VarChar(255)
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  userId     String?  @map("user_id") 

  // Relations
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([identifier, value])
  @@map("verifications")
}

// Completed single-player runs, used for the solo leaderboard
model SoloRun {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  gameType    String   @default("joda-memory") @map("game_type") @db.VarChar(50)
  difficulty  String   @db.VarChar(10)
  timeSeconds Int      @map("time_seconds")
  moves       Int
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([gameType, difficulty, timeSeconds])
  @@index([userId])
  @@map("solo_runs")
}

// Everyone who played a game, for games with more than two players or with teams (Joda Casino).
// Joda Memory keeps using player1/player2 and match_history.
model GameParticipant {
  id     String  @id @default(uuid())
  gameId String  @map("game_id")
  userId String? @map("user_id")
  seat   Int
  team   Int
  name   String  @db.VarChar(100) // display name when the game was played
  result String  @db.VarChar(10) // win | loss | draw
  points Int     @default(0) // the team's match points

  // Relations
  game Game  @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([gameId, seat])
  @@index([userId])
  @@map("game_participants")
}

// Hand-by-hand scores of a team game
model GameHand {
  id          String @id @default(uuid())
  gameId      String @map("game_id")
  handNumber  Int    @map("hand_number")
  dealerSeat  Int    @map("dealer_seat")
  pointsTeam0 Int    @map("points_team0")
  pointsTeam1 Int    @map("points_team1")
  breakdown   Json   @db.JsonB // per team: cards, spades and the points for each scoring item

  // Relations
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, handNumber])
  @@map("game_hands")
}

// The moves of a game kept one row per move (Infinite five-in-a-row). Coordinates are canonical
// decimal strings of any size; a move number and a cell can each appear only once per game.
model GameMove {
  id     String @id @default(uuid())
  gameId String @map("game_id")
  ply    Int
  symbol String @db.VarChar(1)
  x      String @db.VarChar(401)
  y      String @db.VarChar(401)

  // Relations
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, ply])
  @@unique([gameId, x, y])
  @@map("game_moves")
}
